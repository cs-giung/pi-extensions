{
  "name": "pi-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Pi coding agent extensions and project package configuration",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-aufheben/src/index.ts",
      "./packages/pi-council/src/index.ts",
      "./packages/pi-prompt-stash/src/index.ts",
      "./packages/pi-usage/src/index.ts",
      "./packages/pi-usage-codex/src/index.ts",
      "./packages/pi-usage-deepseek/src/index.ts",
      "./packages/pi-usage-zai/src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run --json ./packages/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
