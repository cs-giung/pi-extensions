{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/pi-reviewer-chair/src/**/*.ts",
    "packages/pi-reviewer-chair/tests/**/*.ts",
    "vitest.config.ts"
  ]
}
