{
  "name": "pi-message-timestamps",
  "version": "1.0.0",
  "private": true,
  "description": "Display session-entry timestamps below completed Pi messages",
  "type": "module",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "timestamps"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
