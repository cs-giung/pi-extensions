{
  "name": "pi-reviewer-chair",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal parallel reviewer and chair council extension for Pi",
  "type": "module",
  "files": [
    "src",
    ".pi/reviewer-chair.example.yaml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
